# Copy this file to .env. The app loads .env automatically when python-dotenv is installed.

# Workspace catalog and per-investigation storage root.
# Optional. Defaults to %LOCALAPPDATA%\InvestigationRAG on Windows.
INVESTIGATION_RAG_DATA_DIR=

# Ollama is local only. Do not set this to an external service.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Keep this disabled for sensitive data. Enabling permits non-loopback Ollama URLs.
INVESTIGATION_RAG_ALLOW_REMOTE_OLLAMA=0
OLLAMA_TIMEOUT_SECONDS=120
# Optional answering-model context window. 0 or unset uses the Ollama/model default.
OLLAMA_NUM_CTX=0
# Optional embedding-model context window. 16k is ample for the default chunk sizes.
OLLAMA_EMBED_NUM_CTX=16384

# Set these to models you have pulled locally. Hyde retrieval additionally prefers Gemma4:e4b when installed.
OLLAMA_LLM_MODEL=
OLLAMA_EMBED_MODEL=

# Whole-document entity extraction uses a separate local generation model.
ENTITY_LLM_MODEL=qwen3.6:latest
# 128k context with output headroom for large Dutch reports.
ENTITY_NUM_CTX=131072
ENTITY_OUTPUT_TOKENS=8192
FACT_LEDGER_OUTPUT_TOKENS=16384

# Optional query-side wrapper for instruction-tuned embedding models such as Qwen.
OLLAMA_EMBED_QUERY_INSTRUCTION=Given a user question, retrieve relevant passages from a local document collection that answer the question.

# Structural chunking: target passage size and maximum complete embedding input.
RAG_CHUNK_TARGET_CHARS=2800
RAG_CHUNK_MAX_CHARS=4800
# Estimated token limit, including metadata and overlap (UTF-8 bytes / 3).
# Ollama enforces its actual model limit with truncation disabled.
RAG_CHUNK_MAX_TOKENS=1400
RAG_CHUNK_OVERLAP_CHARS=240
RAG_PDF_CHUNK_SOFT_MIN_CHARS=1200
# PDF overlap mode: none, sentence, or paragraph.
RAG_PDF_CHUNK_OVERLAP_MODE=sentence

# Portable filesystem scan concurrency. Keep these conservative for cloud shares.
SCAN_DISCOVERY_WORKERS=4
SCAN_HASH_WORKERS=2
# Small scans retain per-file diagnostics; large scans use throttled summaries.
SCAN_VERBOSE_FILE_LIMIT=100
